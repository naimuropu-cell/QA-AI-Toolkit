datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  password  String
  name      String
  role      String        @default("qa_engineer")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  projects  Project[]
  logs      ActivityLog[]
}

model Project {
  id              String                @id @default(uuid())
  name            String
  description     String?
  techStack       String?               @default("TypeScript / React")
  testFramework   String?               @default("Playwright")
  qaStandards     String?
  targetUrl       String?
  repositoryPath  String?
  userId          String?
  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  activities      ActivityLog[]
  requirements    RequirementAnalysis[]
  scenarios       TestScenario[]
  testCases       TestCase[]
  bugs            BugReport[]
  apiSuites       ApiTestSuite[]
  automationSuites AutomationSuite[]
  codebaseScans   CodebaseScan[]
  failureDiagnoses TestFailureDiagnosis[]
  automationAudits AutomationAudit[]
  healedLocators  HealedLocator[]
  knowledgeItems  KnowledgeItem[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  target    String
  details   String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model RequirementAnalysis {
  id                 String   @id @default(uuid())
  title              String
  userStory          String
  acceptanceCriteria String?
  analysisJson       String   // Stores structured functional, non-functional, gaps, edge cases, risks
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TestScenario {
  id         String   @id @default(uuid())
  scenarioId String
  title      String
  module     String   @default("General")
  type       String   @default("Positive")
  priority   String   @default("Medium")
  risk       String   @default("Low")
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model TestCase {
  id             String   @id @default(uuid())
  testCaseId     String
  title          String
  module         String   @default("General")
  preconditions  String?
  testData       String?
  steps          String   // JSON string or step-by-step text
  expectedResult String
  priority       String   @default("Medium")
  severity       String   @default("Medium")
  type           String   @default("Functional")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model BugReport {
  id               String   @id @default(uuid())
  title            String
  module           String   @default("General")
  severity         String   @default("Major")
  priority         String   @default("High")
  bugType          String   @default("Functional")
  environment      String   @default("QA / Staging")
  preconditions    String?
  stepsToReproduce String
  expectedResult   String
  actualResult     String
  rootCause        String?
  evidence         String?
  suggestedFix     String?
  regressionRisk   String?
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model ApiTestSuite {
  id            String   @id @default(uuid())
  name          String
  endpoint      String
  method        String   @default("GET")
  headers       String?
  requestBody   String?
  testScenarios String   // JSON string of positive, negative, boundary, security tests
  postmanScript String   // Postman test assertions
  newmanCommand String?  // CLI invocation suggestion
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Automation Rules")
  content   String
  tags      String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationSuite {
  id              String   @id @default(uuid())
  name            String
  framework       String   @default("Playwright-TS") // Playwright-TS, Playwright-JS, Selenium-Python, Selenium-Java
  targetUrl       String?
  pageObjectName  String
  pageObjectCode  String
  testFileCode    String
  fixtureCode     String?
  testDataJson    String?
  folderStructure String?
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model CodebaseScan {
  id                String   @id @default(uuid())
  repositoryName    String
  repositoryPath    String?
  detectedFramework String   @default("Playwright-TS") // Playwright-TS, Playwright-JS, Selenium-Python, Cypress, Jest
  detectedLanguage  String   @default("TypeScript")     // TypeScript, JavaScript, Python, Java
  testDirectory     String?  @default("tests")
  locatorStrategy   String?  @default("getByTestId > getByRole > CSS")
  pageObjectsJson   String   // JSON array of [{ name, filePath, methods: [...] }]
  fixturesJson      String?  // JSON array of [{ name, filePath, description }]
  summaryMetrics    String   // JSON object: { totalFiles, pageObjectsCount, testFilesCount, helperCount }
  rawFileTree       String?  // Sanitized file tree
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TestFailureDiagnosis {
  id                  String   @id @default(uuid())
  testName            String
  framework           String   @default("Playwright") // Playwright, Selenium, Cypress, Jest, Pytest
  errorMessage        String
  stackTrace          String?
  executionLogs       String?
  screenshotUrl       String?
  culpability         String   // "Application Defect" | "Test Automation Flaw" | "Environment / Infrastructure"
  culpabilityScore    Int      // e.g. 85
  culpabilityBreakdown String  // JSON: { appBug: 85, testFlaw: 10, environment: 5 }
  rootCauseCategory   String   // e.g. "Unhandled Null Reference", "Locator Drift", "Async Timeout", etc.
  rootCauseAnalysis   String   // Detailed architectural explanation
  suggestedFixApp     String?  // Developer remediation code/guidance
  suggestedFixTest    String?  // QA test automation remediation
  regressionStubCode  String?  // Playwright/Selenium test stub preventing recurrence
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model AutomationAudit {
  id                String   @id @default(uuid())
  suiteName         String
  framework         String   @default("Playwright") // Playwright, Cypress, Selenium
  scriptContent     String   // The analyzed test code
  healthScore       Int      // 0 - 100 (100 = flawless, 0 = severe rot)
  status            String   @default("COMPLETED") // COMPLETED, NEEDS_REFACTORING, CLEAN
  summary           String   // AI executive diagnosis
  issuesJson        String   // JSON array of [{ id, type, severity, line, title, description, badCode, suggestedFix }]
  refactoredCode    String?  // Fully healed / modernized test script
  metricsJson       String   // JSON: { hardSleepsCount, brittleLocatorsCount, duplicateLogicCount, asyncIssuesCount }
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HealedLocator {
  id                String   @id @default(uuid())
  originalLocator   String
  framework         String   @default("Playwright")
  domSnippet        String?
  targetDescription String?
  healedLocator     String   // Recommended top pick
  resilienceScore   Int      // e.g. 95
  strategy          String   // "ROLE_BASED" | "TEST_ID" | "SEMANTIC_TEXT" | "ARIA" | "HIERARCHICAL"
  alternativesJson  String   // JSON array of [{ locator, strategy, resilienceScore, explanation }]
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

